//@version=6
// Generalized Hurst exponent h(q) of log-volatility increments, evaluated at
// a single low (negative) q — the small-fluctuation-weighted "roughness"
// reading from Takaishi, T. (2019), "Rough volatility of Bitcoin", Finance
// Research Letters, via MF-DFA (Kantelhardt et al., 2002). Simplified,
// single-line version of MMAR_RoughVolatility_LogVol.pine: no h(2), no
// h(qHigh), no multifractality comparison — just h(qLow).
// h(qLow) < 0.5 = rough/anti-persistent log-volatility increments.
indicator("MMAR Rough Volatility h(qLow) [Takaishi 2019]", shorttitle = "MMAR h(qLow)", overlay = false, max_bars_back = 5000, precision = 4)

// ============================ Inputs ============================
grpRV = "Realized Variance / Log-Volatility"
srcClose = input.source(close, "Source", group = grpRV)
rvWindow = input.int(5, "RV aggregation (bars)", minval = 1, group = grpRV,
     tooltip = "Bars summed into one realized-variance observation. 5 ≈ weekly, 20 ≈ monthly.")
lvLag = input.int(5, "Log-volatility increment lag (Δ, bars)", minval = 1, group = grpRV,
     tooltip = "LV_t = log(sqrt(RV_t)) - log(sqrt(RV_(t-Δ))). Set equal to RV aggregation for a like-for-like period-over-period comparison.")

grpEst = "Estimation Window"
lookback = input.int(256, "Lookback (# LV observations)", minval = 32, group = grpEst,
     tooltip = "Number of log-volatility-increment observations used to estimate h(q) via MF-DFA. Should be a power of two (N ∈ 2^k).")
recalcEvery = input.int(5, "Recalculate every N bars", minval = 1, group = grpEst)
q = input.float(-3.0, "q (small-fluctuation weight)", maxval = -0.5, group = grpEst,
     tooltip = "Negative q emphasizes small fluctuations. Keep away from 0 to avoid the 1/q singularity.")
showRefLine = input.bool(true, "Show h=0.5 (random walk / roughness boundary) line")
showTable = input.bool(true, "Show summary table")

// ============================ Log-volatility increments ============================
logRet = math.log(srcClose / srcClose[1])
rv = math.sum(logRet * logRet, rvWindow)
logVol = 0.5 * math.log(rv)
lv = logVol - logVol[lvLag]

// ============================ Generalized MF-DFA h(q) — Kantelhardt et al. (2002), Eq. 4-8 ============================
f_mfdfa(float[] z, int n, float q) =>
    float[] y = array.new<float>(n)
    float mZ = array.avg(z)
    float cum = 0.0
    for i = 0 to n - 1
        cum += array.get(z, i) - mZ
        array.set(y, i, cum)

    int[] scales = array.new<int>()
    int kk = 4
    while kk <= n / 2
        array.push(scales, kk)
        kk *= 2

    float[] logk = array.new<float>()
    float[] logf = array.new<float>()
    for si = 0 to array.size(scales) - 1
        int k = array.get(scales, si)
        int nseg = n / k
        float sumFq = 0.0
        for seg = 0 to nseg - 1
            int start = seg * k
            float sumT = 0.0
            float sumY = 0.0
            float sumTT = 0.0
            float sumTY = 0.0
            for t = 0 to k - 1
                float yy = array.get(y, start + t)
                sumT += t
                sumY += yy
                sumTT += t * t
                sumTY += t * yy
            float denom = k * sumTT - sumT * sumT
            float b = denom != 0 ? (k * sumTY - sumT * sumY) / denom : 0.0
            float a = (sumY - b * sumT) / k
            float sse = 0.0
            for t = 0 to k - 1
                float resid = array.get(y, start + t) - (a + b * t)
                sse += resid * resid
            float f2 = math.max(sse / k, 1e-12)
            sumFq += math.pow(f2, q / 2)
        float fq = math.pow(sumFq / nseg, 1 / q)
        if fq > 0
            array.push(logk, math.log(k))
            array.push(logf, math.log(fq))

    int m = array.size(logk)
    float h = na
    if m >= 2
        float sx = array.sum(logk)
        float sy = array.sum(logf)
        float sxx = 0.0
        float sxy = 0.0
        for i = 0 to m - 1
            float xx = array.get(logk, i)
            float yy = array.get(logf, i)
            sxx += xx * xx
            sxy += xx * yy
        float d = m * sxx - sx * sx
        h := d != 0 ? (m * sxy - sx * sy) / d : na
    h

// ============================ Estimation ============================
var float hQLow = na
bool doCalc = (bar_index % recalcEvery == 0) or barstate.islast

if doCalc and bar_index >= lookback + rvWindow + lvLag
    float[] lvArr = array.new<float>(lookback)
    for i = 0 to lookback - 1
        array.set(lvArr, i, lv[lookback - 1 - i])
    hQLow := f_mfdfa(lvArr, lookback, q)

// ============================ Plot ============================
plot(hQLow, title = "h(qLow)", color = #26A69A, linewidth = 2)

hline(0.5, "h = 0.5 (random walk / roughness boundary)", color = showRefLine ? color.new(color.gray, 40) : na, linestyle = hline.style_dashed)

// ============================ Alerts ============================
alertcondition(ta.crossunder(hQLow, 0.5), title = "h(qLow) turns rough (<0.5)",
     message = "h(qLow) crossed below 0.5: log-volatility increments are becoming anti-persistent/rough (Takaishi, 2019).")
alertcondition(ta.crossover(hQLow, 0.5), title = "h(qLow) turns persistent (>0.5)",
     message = "h(qLow) crossed above 0.5: log-volatility increments are becoming persistent.")

// ============================ Summary table ============================
var table infoTable = table.new(position.top_right, 2, 2, border_width = 1)

if barstate.islast and showTable
    table.cell(infoTable, 0, 0, "h(qLow)", text_halign = text.align_left)
    table.cell(infoTable, 1, 0, str.tostring(hQLow, "#.####"),
         text_color = na(hQLow) ? color.gray : hQLow < 0.5 ? color.red : color.green)

    table.cell(infoTable, 0, 1, "Rough (h<0.5)?", text_halign = text.align_left)
    table.cell(infoTable, 1, 1, na(hQLow) ? "n/a" : hQLow < 0.5 ? "Yes" : "No")
