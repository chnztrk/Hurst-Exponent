//@version=6
// Hurst Exponent (H) — the "Joseph effect" (long memory) half of Grobys (2023)'s
// multifractal asset (in)variance model. Standalone, full-precision, own-pane
// companion to MMAR_PowerLaw_Alpha.pine — add both to a chart to get two
// independently auto-scaled panes instead of one shared/normalized pane.
indicator("MMAR Hurst Exponent (H) [Grobys 2023]", shorttitle = "MMAR Hurst (H)", overlay = false, max_bars_back = 5000, precision = 4)

// ============================ Inputs ============================
grpRV = "Realized Variance"
srcClose = input.source(close, "Source", group = grpRV)
rvWindow = input.int(5, "RV aggregation (bars)", minval = 1, group = grpRV,
     tooltip = "Number of bars whose squared returns are summed into one realized-variance observation. 5 ≈ weekly, 20 ≈ monthly in the paper.")

grpEst = "Estimation Window"
lookback = input.int(256, "Lookback (# RV observations)", minval = 32, group = grpEst,
     tooltip = "Number of realized-variance observations used to estimate H via DFA. Should be a power of two (N ∈ 2^k).")
recalcEvery = input.int(5, "Recalculate every N bars", minval = 1, group = grpEst)

grpBench = "Paper Benchmark (Tables 1-4)"
cascadePreset = input.string("p=0.60 (paper baseline — FX/crypto)", "Benchmark cascade",
     options = ["p=0.55 (mild)", "p=0.60 (paper baseline — FX/crypto)", "p=0.65", "p=0.70 (extreme — commodities/equities)"], group = grpBench)
showBenchmark = input.bool(true, "Show benchmark band", group = grpBench)
showRefLines = input.bool(true, "Show H=0.5 (random walk) / H=1 (stationarity boundary) lines", group = grpBench)

// ============================ Realized variance (Eq. 2-3) ============================
logRet = math.log(srcClose / srcClose[1])
rv = math.sum(logRet * logRet, rvWindow)

// ============================ DFA -> Hurst exponent (Eq. 10-13) ============================
f_dfa(float[] z, int n) =>
    float[] y = array.new<float>(n)
    float mZ = array.avg(z)
    float cum = 0.0
    for i = 0 to n - 1
        cum += array.get(z, i) - mZ
        array.set(y, i, cum)

    int[] scales = array.new<int>()
    int kk = 4
    while kk <= n / 2
        array.push(scales, kk)
        kk *= 2

    float[] logk = array.new<float>()
    float[] logf = array.new<float>()
    for si = 0 to array.size(scales) - 1
        int k = array.get(scales, si)
        int nseg = n / k
        float sumRmse = 0.0
        for seg = 0 to nseg - 1
            int start = seg * k
            float sumT = 0.0
            float sumY = 0.0
            float sumTT = 0.0
            float sumTY = 0.0
            for t = 0 to k - 1
                float yy = array.get(y, start + t)
                sumT += t
                sumY += yy
                sumTT += t * t
                sumTY += t * yy
            float denom = k * sumTT - sumT * sumT
            float b = denom != 0 ? (k * sumTY - sumT * sumY) / denom : 0.0
            float a = (sumY - b * sumT) / k
            float sse = 0.0
            for t = 0 to k - 1
                float resid = array.get(y, start + t) - (a + b * t)
                sse += resid * resid
            sumRmse += math.sqrt(sse / k)
        float rmseK = sumRmse / nseg
        if rmseK > 0
            array.push(logk, math.log(k))
            array.push(logf, math.log(rmseK))

    int m = array.size(logk)
    float H = na
    if m >= 2
        float sx = array.sum(logk)
        float sy = array.sum(logf)
        float sxx = 0.0
        float sxy = 0.0
        for i = 0 to m - 1
            float xx = array.get(logk, i)
            float yy = array.get(logf, i)
            sxx += xx * xx
            sxy += xx * yy
        float d = m * sxx - sx * sx
        H := d != 0 ? (m * sxy - sx * sy) / d : na
    H

// ============================ Estimation ============================
var float hurstVal = na
bool doCalc = (bar_index % recalcEvery == 0) or barstate.islast

if doCalc and bar_index >= lookback + rvWindow
    float[] zArr = array.new<float>(lookback)
    for i = 0 to lookback - 1
        array.set(zArr, i, rv[lookback - 1 - i])
    hurstVal := f_dfa(zArr, lookback)

// ============================ Benchmark cascade lookup (Tables 1-4, H column) ============================
float benchHLo = 0.8503
float benchHHi = 0.9142
if cascadePreset == "p=0.55 (mild)"
    benchHLo := 0.7616
    benchHHi := 0.8593
else if cascadePreset == "p=0.65"
    benchHLo := 0.8659
    benchHHi := 0.9407
else if cascadePreset == "p=0.70 (extreme — commodities/equities)"
    benchHLo := 0.8843
    benchHHi := 0.9269

// ============================ Plot ============================
plot(hurstVal, title = "Hurst Exponent (H)", color = #2962FF, linewidth = 2)

hline(0.5, "H = 0.5 (random walk)", color = showRefLines ? color.new(color.gray, 40) : na, linestyle = hline.style_dashed)
hline(1.0, "H = 1 (stationarity boundary)", color = showRefLines ? color.new(color.purple, 40) : na, linestyle = hline.style_dashed)
hline(benchHLo, "Benchmark H 5%", color = showBenchmark ? color.new(#2962FF, 70) : na, linestyle = hline.style_dotted)
hline(benchHHi, "Benchmark H 95%", color = showBenchmark ? color.new(#2962FF, 70) : na, linestyle = hline.style_dotted)

alertcondition(ta.crossover(hurstVal, 1.0), title = "H crosses above 1 (unbounded regime)",
     message = "Hurst exponent crossed above 1: the realized-variance process is entering a non-stationary, self-reinforcing persistence regime (Grobys, 2023).")
alertcondition(ta.crossunder(hurstVal, 0.5), title = "H crosses below 0.5 (antipersistent regime)",
     message = "Hurst exponent crossed below 0.5: the realized-variance process is turning antipersistent (mean-reverting).")
