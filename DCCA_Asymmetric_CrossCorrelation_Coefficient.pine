//@version=6
// Asymmetric DCCA cross-correlation coefficient between price and
// volatility, following Kakinaka, S. & Umeno, K. (2021), "Exploring
// asymmetric multifractal cross-correlations of price-volatility and
// asymmetric volatility dynamics in cryptocurrency markets", Physica A 581,
// 126237 (their Section 3.2/4.2), which builds on the DCCA coefficient of
// Zhende (2011)/Podobnik et al. (2011) and its asymmetric extension by Cao
// et al. (2018).
// This is a companion to MF_ADCCA_Asymmetric_CrossCorrelation.pine, but a
// DIFFERENT metric answering a different question. That indicator ports the
// paper's Section 3.1 (MF-ADCCA): a multifractal, non-overlapping-segment
// generalized cross-Hurst exponent asymmetry Δh_xy(q), which is about how
// the SCALING of price-volatility fluctuations differs between trends. This
// indicator ports Section 3.2/4.2: a single, bounded [-1,1] correlation
// coefficient ρ_DCCA(s) computed from OVERLAPPING windows of length s+1,
// split into uptrend/downtrend windows by the sign of a linear fit on price
// within each window. This ρ_DCCA± is what the paper's leverage-effect /
// asymmetric-volatility conclusions are actually based on (Section 4.2,
// cross-validated there against EGARCH/GJR-GARCH): |ρDCCA-(s)| > |ρDCCA+(s)|
// means price-volatility cross-correlation is stronger in downtrends
// ("asymmetric volatility", the familiar leverage-effect direction);
// |ρDCCA-(s)| < |ρDCCA+(s)| means the reverse ("inverse-asymmetric
// volatility", which the paper finds for smaller-cap coins).
// Simplification relative to the paper, consistent with this indicator
// suite's other detrending steps: segments/windows use a linear (order-1)
// fit rather than the paper's degree-2 polynomial. The scale s is a single
// fixed input rather than swept across a range (the paper's Fig. 6 sweeps
// s continuously from ~10 to ~334 days at one point in time — a static
// snapshot); this indicator instead plots ρ_DCCA(s)/ρ_DCCA+(s)/ρ_DCCA-(s)
// for one chosen s evolving through time, matching how every other
// indicator in this suite is built (a rolling metric, not a one-off curve).
indicator("Asymmetric DCCA Coefficient [Kakinaka & Umeno 2021]", shorttitle = "Asym DCCA", overlay = false, max_bars_back = 5000, precision = 4)

// ============================ Inputs ============================
grpRV = "Realized Variance / Log-Volatility"
srcClose = input.source(close, "Source", group = grpRV)
rvWindow = input.int(5, "RV aggregation (bars)", minval = 1, group = grpRV,
     tooltip = "Bars summed into one realized-variance observation. 5 ≈ weekly, 20 ≈ monthly.")
lvLag = input.int(5, "Log-volatility increment lag (Δ, bars)", minval = 1, group = grpRV,
     tooltip = "LV_t = log(sqrt(RV_t)) - log(sqrt(RV_(t-Δ))). Set equal to RV aggregation for a like-for-like period-over-period comparison.")

grpEst = "Estimation Window"
lookback = input.int(120, "Lookback (# observations, N)", minval = 64, group = grpEst,
     tooltip = "Number of paired (return, log-volatility-increment) observations spanning the overlapping-window scan. Lowered from the paper-scale default (256) to react faster to trend changes — fewer stale bars dilute the up/down window classification — at the cost of noisier ρ+/ρ- estimates from fewer windows per side. Raise it back toward 200-256 if the readout looks too jumpy for your timeframe.")
scaleS = input.int(20, "DCCA window scale (s, bars)", minval = 5, group = grpEst,
     tooltip = "Window length used for the overlapping-window DCCA fluctuation functions (window covers s+1 points). The paper sweeps s from ~10 to ~334 days; this indicator fixes one s and tracks it through time instead.")
recalcEvery = input.int(5, "Recalculate every N bars", minval = 1, group = grpEst)

grpDisp = "Display"
showAll = input.bool(true, "Show ρ_DCCA (overall trend)", group = grpDisp)
showRefLine = input.bool(true, "Show ρ=0 (no cross-correlation) line", group = grpDisp)
showTable = input.bool(true, "Show summary table", group = grpDisp)
colorAll = input.color(#787B86, "ρ_DCCA (overall) color", group = grpDisp)
colorPlus = input.color(#26A69A, "ρ_DCCA+ (uptrend) color", group = grpDisp)
colorMinus = input.color(#EF5350, "ρ_DCCA- (downtrend) color", group = grpDisp)

// ============================ ρ from accumulated sums (Eq. 12-13) ============================
f_rho(float sumDcca, float sumDfax, float sumDfay, int cnt) =>
    float rho = na
    if cnt > 0
        float f2DccaAvg = sumDcca / cnt
        float fDfaxAvg = math.sqrt(math.max(sumDfax / cnt, 1e-14))
        float fDfayAvg = math.sqrt(math.max(sumDfay / cnt, 1e-14))
        float denomRho = fDfaxAvg * fDfayAvg
        if denomRho > 0
            rho := math.max(math.min(f2DccaAvg / denomRho, 1.0), -1.0)
    rho

// ============================ Asymmetric DCCA coefficient — Kakinaka & Umeno (2021) Eq. 10-13 ============================
// Returns [rhoAll, rhoPlus, rhoMinus]. Uses overlapping windows of length
// s+1 (not the non-overlapping segments of the MF-ADCCA companion
// indicator), classifying each window as uptrend/downtrend by the sign of
// a linear fit on price within that window.
f_dccaCoef(float[] xArr, float[] yArr, float[] pArr, int n, int s) =>
    float[] Rx = array.new<float>(n)
    float[] Ry = array.new<float>(n)
    float mX = array.avg(xArr)
    float mY = array.avg(yArr)
    float cx = 0.0
    float cy = 0.0
    for i = 0 to n - 1
        cx += array.get(xArr, i) - mX
        cy += array.get(yArr, i) - mY
        array.set(Rx, i, cx)
        array.set(Ry, i, cy)

    int wlen = s + 1
    int nWin = n - s

    float sumDccaAll = 0.0
    float sumDfaxAll = 0.0
    float sumDfayAll = 0.0
    int cntAll = 0
    float sumDccaPlus = 0.0
    float sumDfaxPlus = 0.0
    float sumDfayPlus = 0.0
    int cntPlus = 0
    float sumDccaMinus = 0.0
    float sumDfaxMinus = 0.0
    float sumDfayMinus = 0.0
    int cntMinus = 0

    if nWin > 0
        for iw = 0 to nWin - 1
            // First pass: linear-fit sums for Rx, Ry (detrending) and P
            // (trend-direction classifier) within this overlapping window.
            float sumT = 0.0
            float sumTT = 0.0
            float sumRxW = 0.0
            float sumTRx = 0.0
            float sumRyW = 0.0
            float sumTRy = 0.0
            float sumP = 0.0
            float sumTP = 0.0
            for t = 0 to wlen - 1
                float tv = t
                float rxv = array.get(Rx, iw + t)
                float ryv = array.get(Ry, iw + t)
                float pv = array.get(pArr, iw + t)
                sumT += tv
                sumTT += tv * tv
                sumRxW += rxv
                sumTRx += tv * rxv
                sumRyW += ryv
                sumTRy += tv * ryv
                sumP += pv
                sumTP += tv * pv
            float denom = wlen * sumTT - sumT * sumT
            float bX = denom != 0 ? (wlen * sumTRx - sumT * sumRxW) / denom : 0.0
            float aX = (sumRxW - bX * sumT) / wlen
            float bY = denom != 0 ? (wlen * sumTRy - sumT * sumRyW) / denom : 0.0
            float aY = (sumRyW - bY * sumT) / wlen
            float bP = denom != 0 ? (wlen * sumTP - sumT * sumP) / denom : 0.0

            // Second pass: signed detrended cross-covariance and each
            // series' own detrended variance (no absolute value here — the
            // sign of the covariance is the whole point of this metric).
            float sumProd = 0.0
            float sumXX = 0.0
            float sumYY = 0.0
            for t = 0 to wlen - 1
                float tv = t
                float rxv = array.get(Rx, iw + t)
                float ryv = array.get(Ry, iw + t)
                float xResid = rxv - (aX + bX * tv)
                float yResid = ryv - (aY + bY * tv)
                sumProd += xResid * yResid
                sumXX += xResid * xResid
                sumYY += yResid * yResid
            float f2dcca = sumProd / wlen
            float f2dfax = sumXX / wlen
            float f2dfay = sumYY / wlen

            sumDccaAll += f2dcca
            sumDfaxAll += f2dfax
            sumDfayAll += f2dfay
            cntAll += 1
            if bP >= 0
                sumDccaPlus += f2dcca
                sumDfaxPlus += f2dfax
                sumDfayPlus += f2dfay
                cntPlus += 1
            else
                sumDccaMinus += f2dcca
                sumDfaxMinus += f2dfax
                sumDfayMinus += f2dfay
                cntMinus += 1

    float rhoAll = f_rho(sumDccaAll, sumDfaxAll, sumDfayAll, cntAll)
    float rhoPlus = f_rho(sumDccaPlus, sumDfaxPlus, sumDfayPlus, cntPlus)
    float rhoMinus = f_rho(sumDccaMinus, sumDfaxMinus, sumDfayMinus, cntMinus)
    [rhoAll, rhoPlus, rhoMinus]

// ============================ Estimation ============================
logRet = math.log(srcClose / srcClose[1])
rv = math.sum(logRet * logRet, rvWindow)
logVol = 0.5 * math.log(rv)
lv = logVol - logVol[lvLag]

var float rhoAll = na
var float rhoPlus = na
var float rhoMinus = na

bool doCalc = (bar_index % recalcEvery == 0) or barstate.islast

if doCalc and bar_index >= lookback + rvWindow + lvLag
    float[] xArr = array.new<float>(lookback)
    float[] yArr = array.new<float>(lookback)
    float[] pArr = array.new<float>(lookback)
    for i = 0 to lookback - 1
        array.set(xArr, i, logRet[lookback - 1 - i])
        array.set(yArr, i, lv[lookback - 1 - i])
        array.set(pArr, i, srcClose[lookback - 1 - i])

    [rAll, rPlus, rMinus] = f_dccaCoef(xArr, yArr, pArr, lookback, scaleS)
    rhoAll := rAll
    rhoPlus := rPlus
    rhoMinus := rMinus

// ============================ Plots ============================
plot(showAll ? rhoAll : na, title = "ρ_DCCA — overall trend", color = colorAll, linewidth = 1)
p1 = plot(rhoPlus, title = "ρ_DCCA+ — uptrend windows", color = colorPlus, linewidth = 2)
p2 = plot(rhoMinus, title = "ρ_DCCA- — downtrend windows", color = colorMinus, linewidth = 2)
fill(p1, p2, color = math.abs(rhoMinus) >= math.abs(rhoPlus) ? color.new(colorMinus, 85) : color.new(colorPlus, 85))

hline(0.0, "ρ = 0 (no cross-correlation)", color = showRefLine ? color.new(color.gray, 40) : na, linestyle = hline.style_dashed)

// ============================ Alerts ============================
alertcondition(ta.crossover(math.abs(rhoMinus), math.abs(rhoPlus)), title = "Regime flips to asymmetric (downtrend-dominant)",
     message = "|ρDCCA-(s)| crossed above |ρDCCA+(s)|: price-volatility cross-correlation is now stronger in downtrends — asymmetric volatility / leverage-effect direction (Kakinaka & Umeno, 2021).")
alertcondition(ta.crossover(math.abs(rhoPlus), math.abs(rhoMinus)), title = "Regime flips to inverse-asymmetric (uptrend-dominant)",
     message = "|ρDCCA+(s)| crossed above |ρDCCA-(s)|: price-volatility cross-correlation is now stronger in uptrends — inverse-asymmetric volatility (Kakinaka & Umeno, 2021).")

// ============================ Summary table ============================
var table infoTable = table.new(position.top_right, 2, 7, border_width = 1)

if barstate.islast and showTable
    table.cell(infoTable, 0, 0, "Asymmetric DCCA (Kakinaka & Umeno 2021)", bgcolor = color.new(color.gray, 70), text_color = color.white, text_halign = text.align_left)
    table.cell(infoTable, 1, 0, "", bgcolor = color.new(color.gray, 70))

    table.cell(infoTable, 0, 1, "ρ_DCCA (overall trend)", text_halign = text.align_left)
    table.cell(infoTable, 1, 1, str.tostring(rhoAll, "#.####"))

    table.cell(infoTable, 0, 2, "ρ_DCCA+ (uptrend)", text_halign = text.align_left)
    table.cell(infoTable, 1, 2, str.tostring(rhoPlus, "#.####"))

    table.cell(infoTable, 0, 3, "ρ_DCCA- (downtrend)", text_halign = text.align_left)
    table.cell(infoTable, 1, 3, str.tostring(rhoMinus, "#.####"))

    table.cell(infoTable, 0, 4, "|ρ-| vs |ρ+|", text_halign = text.align_left)
    diffAbs = na(rhoPlus) or na(rhoMinus) ? na : math.abs(rhoMinus) - math.abs(rhoPlus)
    table.cell(infoTable, 1, 4, na(diffAbs) ? "n/a" : str.tostring(diffAbs, "#.####"))

    regimeText = na(rhoPlus) or na(rhoMinus) ? "n/a" : math.abs(diffAbs) < 0.02 ? "Symmetric (|Δρ|<0.02)" : math.abs(rhoMinus) > math.abs(rhoPlus) ? "Asymmetric volatility (stronger in DOWNTREND — leverage-effect direction)" : "Inverse-asymmetric volatility (stronger in UPTREND)"
    table.cell(infoTable, 0, 5, "Regime", text_halign = text.align_left)
    table.cell(infoTable, 1, 5, regimeText)

    table.cell(infoTable, 0, 6, "Scale s (bars)", text_halign = text.align_left)
    table.cell(infoTable, 1, 6, str.tostring(scaleS))
